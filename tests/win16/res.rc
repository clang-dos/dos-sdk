/* Resources of every kind for res.c, compiled with llvm-rc -win16. For
 * Windows 1.x and 2.x (llvm-rc -win16-version 2.03), the icon is in their
 * format (res2.ico) and the dialog has no font. */
#include <windows.h>
#include "res.h"

#if WINVER >= 0x0300
APPICON ICON "res.ico"
#else
APPICON ICON "res2.ico"
#endif

STRINGTABLE
BEGIN
  IDS_HELLO "Hello from a resource"
  IDS_SECOND "Second bundle"
END

IDM_MAIN MENU
BEGIN
  POPUP "&File"
  BEGIN
    MENUITEM "&Open...", IDM_OPEN
    MENUITEM SEPARATOR
    MENUITEM "E&xit", IDM_EXIT
  END
END

IDA_MAIN ACCELERATORS
BEGIN
  "^O", IDM_OPEN
  VK_F4, IDM_EXIT, VIRTKEY, ALT
END

IDD_ABOUT DIALOG 10, 10, 160, 60
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About"
#if WINVER >= 0x0300
FONT 8, "MS Sans Serif"
#endif
BEGIN
  LTEXT "Name:", -1, 8, 8, 40, 10
  EDITTEXT IDC_NAME, 50, 6, 100, 12
  DEFPUSHBUTTON "OK", IDOK, 55, 40, 50, 14
END

IDR_DATA RCDATA
BEGIN
  0x1234, 0x5678L, "data\0"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 2, 3, 4
PRODUCTVERSION 1, 2, 0, 0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_DOS_WINDOWS16
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904E4"
    BEGIN
      VALUE "ProductName", "clang-dos test\0"
      VALUE "FileVersion", "1.2.3.4\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1252
  END
END

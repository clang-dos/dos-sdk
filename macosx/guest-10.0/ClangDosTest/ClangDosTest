#!/bin/sh
# Mac OS X 10.0 has no launchd, so the test runner is a StartupItem.
# SystemStarter runs it after the Disks item has mounted removable
# media. If a disk named CDTEST is attached, copy it to /tmp, run its
# run.sh, write the output back as OUT.TXT and power off. Without that
# disk it does nothing.
. /etc/rc.common
vol=/Volumes/CDTEST
n=0
while [ ! -f "$vol/run.sh" ]; do
  n=$((n + 1))
  [ $n -gt 30 ] && exit 0
  sleep 1
done
ConsoleMessage "Running clang-dos tests"
work=/tmp/cdtest
rm -rf "$work"
mkdir -p "$work"
cp -R "$vol/" "$work/"
chmod -R u+x "$work"
cd "$work" || exit 1
rm -f "$vol/OUT.TXT" "$vol/DONE.TXT"
/bin/sh ./run.sh >"$vol/OUT.TXT" 2>&1
echo done >"$vol/DONE.TXT"
sync
cd /
umount "$vol"
sync
/sbin/shutdown -h now
